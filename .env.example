# ==============================================================================
# Speech-to-Speech Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model & Backend Selection
# ------------------------------------------------------------------------------
# Model name to use (e.g. gemini-2.5-flash, gemini-2.0-flash, gpt-4o-mini, llama-3.3-70b-versatile)
MODEL_NAME=gemini-2.5-flash

# LLM Backend:
#   - 'chat-completions' (for Gemini, Groq, DeepSeek, OpenRouter, Together)
#   - 'responses-api' (for official OpenAI Responses API)
#   - 'transformers' (for local Hugging Face models)
LLM_BACKEND=chat-completions

# ------------------------------------------------------------------------------
# 2. Provider API Keys
# (Set the key for the provider you want to use; the system auto-selects the right key)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# Generic fallback key (if using a custom proxy/endpoint)
# LLM_API_KEY=

# ------------------------------------------------------------------------------
# 3. Provider Base URLs (Optional Override)
# (Leave commented out to use built-in official defaults)
# ------------------------------------------------------------------------------
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=

# ------------------------------------------------------------------------------
# 4. Runtime & Portability Settings (Optional)
# ------------------------------------------------------------------------------
# Auto-sanitize host LD_LIBRARY_PATH on Linux to prevent cuDNN version conflicts (1=enabled, 0=disabled)
# S2S_SANITIZE_CUDA_ENV=1
