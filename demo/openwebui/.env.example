# Docker-to-host addresses on Docker Desktop for macOS; include /v1, not /realtime.
OPENAI_API_BASE_URL=http://host.docker.internal:8089/v1
AUDIO_REALTIME_OPENAI_API_BASE_URL=http://host.docker.internal:8765/v1
MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# These local services do not authenticate. "none" is a placeholder, not a credential.
# Put any real endpoint keys only in your ignored .env file.
OPENAI_API_KEY=none
AUDIO_REALTIME_OPENAI_API_KEY=none
