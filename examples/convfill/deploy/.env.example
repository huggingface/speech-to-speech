# Values below are deployment examples. Put real keys in server-side secrets.
CONVFILL_CONFIG=configs/demo_mode/convfill_hosted_config.json
CONVFILL_REASONER_URL=http://reasoner:8000/v1
CONVFILL_REASONER_MODEL=nvidia/Gemma-4-31B-IT-NVFP4
CONVFILL_REASONER_API_KEY=
CONVFILL_TALKER_URL=http://talker:8000/v1
CONVFILL_TALKER_API_KEY=
CONVFILL_STT_URL=https://stt.example.com/v1
CONVFILL_STT_MODEL=Qwen/Qwen3-ASR-1.7B
CONVFILL_STT_API_KEY=
CONVFILL_TTS_URL=https://tts.example.com/v1
CONVFILL_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
CONVFILL_TTS_VOICE=aiden
CONVFILL_TTS_API_KEY=
HF_S2S_STT=openai
HF_S2S_TTS=openai
CONVFILL_LOG_CONTENT=0

# Optional server-side search key. Never sent in /api/config.
SERPER_API_KEY=
# Set explicitly empty to disable the initial greeting.
STARTUP_GREETING=Greet the user warmly in one short sentence, then invite them to talk.
